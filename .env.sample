# Copier ce fichier en .env (à la racine du repo) et le remplir.
# .env est ignoré par git : ne jamais committer de clé.

# URL de service de l'instance watsonx Orchestrate
# (Orchestrate → profil → Settings → API details)
WXO_URL=https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<instance-id>

# Clé API IBM Cloud de l'instance (même écran : Generate API key)
WXO_API_KEY=

# (Optionnel) URL du serveur MCP OpenPages utilisé par IBM Bob
OPENPAGES_MCP_URL=https://<mcp-server-host>/mcp
