# Copy this file to .env.sdk (repo root) and fill it in.
# .env.sdk is ignored by git: never commit a key.

# watsonx Orchestrate configuration
WO_DEVELOPER_EDITION_SOURCE=orchestrate
WO_INSTANCE_ALIAS=openpages-demo
# Service URL (Orchestrate → profile → Settings → API details)
WO_INSTANCE=https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<instance-id>
# IBM Cloud API key of the instance (same screen: Generate API key)
WO_API_KEY=<your-api-key>

# (Optional) OpenPages MCP server used by IBM Bob
OPENPAGES_MCP_URL=https://<mcp-server-host>/mcp
